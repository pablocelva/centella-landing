---
import styles from './ProjectFilter.module.css';
---

<nav class={styles.filterBar} aria-label="Filtrar catálogo por formato de producción">
  <span class={styles.filterLabel}>FILTRAR POR FORMATO:</span>
  <button data-category-filter="all" data-active="true" class={styles.filterBtn}>
    [TODOS]
  </button>
  <button data-category-filter="álbum lp" data-active="false" class={styles.filterBtn}>
    [ÁLBUM LP]
  </button>
  <button data-category-filter="sencillo" data-active="false" class={styles.filterBtn}>
    [SENCILLOS]
  </button>
  <button data-category-filter="ep" data-active="false" class={styles.filterBtn}>
    [EP]
  </button>
</nav>

<script is:inline>
  (function () {
    function setupCategoryFilter() {
      const filterBtns = document.querySelectorAll('[data-category-filter]');
      const cards = document.querySelectorAll('[data-project-card]');

      if (!filterBtns.length || !cards.length) return;

      filterBtns.forEach(btn => {
        const freshBtn = btn.cloneNode(true);
        btn.parentNode.replaceChild(freshBtn, btn);

        freshBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const selectedCategory = freshBtn.getAttribute('data-category-filter');

          // Update active status across filter buttons
          document.querySelectorAll('[data-category-filter]').forEach(b => {
            b.setAttribute('data-active', b === freshBtn ? 'true' : 'false');
          });

          // Show/hide project cards according to selected category
          document.querySelectorAll('[data-project-card]').forEach(card => {
            const cardCat = (card.getAttribute('data-category') || '').toLowerCase();
            if (selectedCategory === 'all' || cardCat.includes(selectedCategory)) {
              card.style.display = 'grid';
            } else {
              card.style.display = 'none';
            }
          });
        });
      });
    }

    document.addEventListener('astro:page-load', setupCategoryFilter);
    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      setupCategoryFilter();
    } else {
      document.addEventListener('DOMContentLoaded', setupCategoryFilter);
    }
  })();
</script>
