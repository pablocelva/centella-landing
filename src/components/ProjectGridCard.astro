---
import { Image } from 'astro:assets';
import { resolveCoverImage } from '../utils/images';
import styles from './ProjectGridCard.module.css';

interface ServiceBadge {
  slug: string;
  label: string;
}

interface Props {
  id: string;
  title: string;
  artist: string;
  year: string;
  category: string;
  coverImage: string;
  serviceBadges?: ServiceBadge[];
  index?: number;
}

const {
  id,
  title,
  artist,
  year,
  category,
  coverImage,
  serviceBadges = [],
  index = 4,
} = Astro.props;

const resolvedCover = resolveCoverImage(coverImage);
const isAboveFold = index < 4;
const isPrimaryLcp = index === 0;
---

<article class={styles.card} data-project-card data-category={category.toLowerCase()}>
  <a
    href={`/proyectos/${id}`}
    class={styles.cardLink}
    title={`${title} — ${artist}`}
    aria-label={`Ver proyecto ${title} por ${artist}`}
  >
    <div class={styles.imageWrapper}>
      {resolvedCover ? (
        <Image
          src={resolvedCover}
          alt={`Carátula de ${title} por ${artist}`}
          width={520}
          height={520}
          format="webp"
          quality={82}
          class={styles.coverImg}
          loading={isAboveFold ? 'eager' : 'lazy'}
          fetchpriority={isPrimaryLcp ? 'high' : undefined}
        />
      ) : (
        <img
          src={coverImage}
          alt={`Carátula de ${title} por ${artist}`}
          width="520"
          height="520"
          class={styles.coverImg}
          loading={isAboveFold ? 'eager' : 'lazy'}
          fetchpriority={isPrimaryLcp ? 'high' : undefined}
          decoding="async"
        />
      )}
      <div class={styles.hoverOverlay}>
        <span class={styles.overlayMeta}>
          {category} &bull; {year}
        </span>
        <span class={styles.overlayAction}>VER PROYECTO &rarr;</span>
      </div>
    </div>

    <div class={styles.cardInfo}>
      <h3 class={styles.artist}>{artist}</h3>
      <span class={styles.title}>{title}</span>
      {serviceBadges.length > 0 && (
        <div class={styles.badgeRow}>
          {serviceBadges.slice(0, 2).map((badge) => (
            <span class={styles.miniBadge}>[{badge.label}]</span>
          ))}
        </div>
      )}
    </div>
  </a>
</article>

