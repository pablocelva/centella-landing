---
import { getCollection, type CollectionEntry } from 'astro:content';
import styles from './ProjectsCarousel.module.css';

type Proyecto = CollectionEntry<'proyectos'>;

interface Props {
  serviceSlug?: string;
  serviceTitle?: string;
  sectionNumber?: string;
  title?: string;
  tag?: string;
  currentProjectId?: string;
  relatedServiceSlugs?: string[];
}

const {
  serviceSlug = '',
  serviceTitle = '',
  sectionNumber = '03',
  title: customTitle,
  tag: customTag,
  currentProjectId = '',
  relatedServiceSlugs = []
} = Astro.props;

// Fetch all active/featured projects
const allProjects = await getCollection('proyectos');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

// Exclude current project if specified (for single project detail pages)
const eligibleProjects = currentProjectId
  ? sortedProjects.filter(p => p.id !== currentProjectId)
  : sortedProjects;

// Filtering rules:
let filteredProjects: Proyecto[] = eligibleProjects;

if (relatedServiceSlugs && relatedServiceSlugs.length > 0) {
  const matching = eligibleProjects.filter(project => {
    const badges = project.data.serviceBadges || [];
    return badges.some(b => relatedServiceSlugs.includes(b.slug));
  });
  filteredProjects = matching.length >= 3 ? matching : eligibleProjects;
} else if (serviceSlug) {
  const isConsultoria = serviceSlug.includes('consultoria') || serviceSlug === '';
  filteredProjects = isConsultoria
    ? eligibleProjects
    : eligibleProjects.filter(project => {
        const badges = project.data.serviceBadges || [];
        return badges.some(b => {
          if (serviceSlug === 'produccion-musical') {
            return b.slug === 'produccion-musical' || b.slug.includes('produccion');
          }
          if (serviceSlug === 'mezcla') {
            return b.slug === 'mezcla';
          }
          return b.slug === serviceSlug || b.slug.includes(serviceSlug);
        });
      });
}

// Determine dynamic heading tags & titles
let displayTag = customTag;
let displayTitle = customTitle;

if (!displayTag) {
  if (relatedServiceSlugs.length > 0) {
    displayTag = `[${sectionNumber}] PRODUCCIONES RELACIONADAS // ${filteredProjects.length} OBRAS`;
  } else if (serviceSlug === 'produccion-musical') {
    displayTag = `[${sectionNumber}] TRABAJOS DE PRODUCCIÓN MUSICAL // ${filteredProjects.length} PROYECTOS`;
  } else if (serviceSlug === 'mezcla') {
    displayTag = `[${sectionNumber}] TRABAJOS DE MEZCLA DE AUDIO // ${filteredProjects.length} PROYECTOS`;
  } else if (serviceSlug.includes('consultoria') || serviceSlug === '') {
    displayTag = `[${sectionNumber}] CATÁLOGO COMPLETO DE PROYECTOS // ${filteredProjects.length} PRODUCCIONES`;
  } else {
    displayTag = `[${sectionNumber}] PROYECTOS DESTACADOS // ${filteredProjects.length} TRABAJOS`;
  }
}

if (!displayTitle) {
  if (relatedServiceSlugs.length > 0) {
    displayTitle = 'Otras Obras y Trabajos Realizados en el Estudio';
  } else if (serviceSlug === 'produccion-musical') {
    displayTitle = 'Obras Producidas en Estudio Centella';
  } else if (serviceSlug === 'mezcla') {
    displayTitle = 'Mezclas Realizadas en Estudio Centella';
  } else if (serviceSlug.includes('consultoria') || serviceSlug === '') {
    displayTitle = 'Discografía y Proyectos Desarrollados en el Estudio';
  } else {
    displayTitle = `Proyectos de ${serviceTitle || 'Estudio Centella'}`;
  }
}

// Duplicate items in display set if count is small so group width W always exceeds viewport width
let displayProjects: Proyecto[] = [...filteredProjects];
while (displayProjects.length > 0 && displayProjects.length < 6) {
  displayProjects = [...displayProjects, ...filteredProjects];
}

const shouldAnimate = filteredProjects.length >= 2;
---

{filteredProjects.length > 0 && (
  <section class={styles.carouselSection} aria-labelledby="carousel-title" data-projects-carousel>
    <div class={styles.headerRow}>
      <div class={styles.titleGroup}>
        <span class={styles.sectionTag}>{displayTag}</span>
        <h2 id="carousel-title" class={styles.sectionTitle}>{displayTitle}</h2>
      </div>

      <div class={styles.controlsRow}>
        {shouldAnimate && (
          <>
            <button
              type="button"
              class={styles.controlBtn}
              data-carousel-toggle
              title="Pausar o reanudar avance continuo"
            >
              [⏹]
            </button>
            <button
              type="button"
              class={styles.controlBtn}
              data-carousel-reverse
              title="Invertir dirección del carrusel"
            >
              [⇄]
            </button>
          </>
        )}
        <a href="/proyectos" class={styles.allProjectsLink}>
          VER CATÁLOGO &rarr;
        </a>
      </div>
    </div>

    {shouldAnimate ? (
      <div class={styles.trackWrapper} data-carousel-wrapper>
        <div class={styles.track} data-carousel-track>
          {/* Primary Set */}
          <div class={styles.itemGroup} data-carousel-group>
            {displayProjects.map((project: Proyecto) => (
              <a
                href={`/proyectos/${project.id}`}
                class={styles.card}
                title={`${project.data.title} — ${project.data.artist}`}
                draggable="false"
              >
                <div class={styles.imageWrapper}>
                  <img
                    src={project.data.coverImage}
                    alt={`Portada de ${project.data.title} por ${project.data.artist}`}
                    class={styles.coverImg}
                    loading="lazy"
                    draggable="false"
                  />
                  <div class={styles.hoverOverlay}>
                    <span class={styles.overlayMeta}>
                      {project.data.category} &bull; {project.data.year}
                    </span>
                    <span class={styles.overlayAction}>VER PROYECTO &rarr;</span>
                  </div>
                </div>
                <div class={styles.cardInfo}>
                  <h3 class={styles.artist}>{project.data.artist}</h3>
                  <span class={styles.title}>{project.data.title}</span>
                  <div class={styles.badgeRow}>
                    {project.data.serviceBadges.slice(0, 2).map((badge: { slug: string; label: string }) => (
                      <span class={styles.miniBadge}>[{badge.label}]</span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>

          {/* Duplicate Set 1 (Center Working Set) */}
          <div class={styles.itemGroup} aria-hidden="true">
            {displayProjects.map((project: Proyecto) => (
              <a
                href={`/proyectos/${project.id}`}
                class={styles.card}
                tabindex="-1"
                title={`${project.data.title} — ${project.data.artist}`}
                draggable="false"
              >
                <div class={styles.imageWrapper}>
                  <img
                    src={project.data.coverImage}
                    alt=""
                    class={styles.coverImg}
                    loading="lazy"
                    draggable="false"
                  />
                  <div class={styles.hoverOverlay}>
                    <span class={styles.overlayMeta}>
                      {project.data.category} &bull; {project.data.year}
                    </span>
                    <span class={styles.overlayAction}>VER PROYECTO &rarr;</span>
                  </div>
                </div>
                <div class={styles.cardInfo}>
                  <h3 class={styles.artist}>{project.data.artist}</h3>
                  <span class={styles.title}>{project.data.title}</span>
                  <div class={styles.badgeRow}>
                    {project.data.serviceBadges.slice(0, 2).map((badge: { slug: string; label: string }) => (
                      <span class={styles.miniBadge}>[{badge.label}]</span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>

          {/* Duplicate Set 2 */}
          <div class={styles.itemGroup} aria-hidden="true">
            {displayProjects.map((project: Proyecto) => (
              <a
                href={`/proyectos/${project.id}`}
                class={styles.card}
                tabindex="-1"
                title={`${project.data.title} — ${project.data.artist}`}
                draggable="false"
              >
                <div class={styles.imageWrapper}>
                  <img
                    src={project.data.coverImage}
                    alt=""
                    class={styles.coverImg}
                    loading="lazy"
                    draggable="false"
                  />
                  <div class={styles.hoverOverlay}>
                    <span class={styles.overlayMeta}>
                      {project.data.category} &bull; {project.data.year}
                    </span>
                    <span class={styles.overlayAction}>VER PROYECTO &rarr;</span>
                  </div>
                </div>
                <div class={styles.cardInfo}>
                  <h3 class={styles.artist}>{project.data.artist}</h3>
                  <span class={styles.title}>{project.data.title}</span>
                  <div class={styles.badgeRow}>
                    {project.data.serviceBadges.slice(0, 2).map((badge: { slug: string; label: string }) => (
                      <span class={styles.miniBadge}>[{badge.label}]</span>
                    ))}
                  </div>
                </div>
              </a>
            ))}
          </div>
        </div>
      </div>
    ) : (
      <div class={styles.staticGrid}>
        {filteredProjects.map((project: Proyecto) => (
          <a
            href={`/proyectos/${project.id}`}
            class={styles.card}
            title={`${project.data.title} — ${project.data.artist}`}
          >
            <div class={styles.imageWrapper}>
              <img
                src={project.data.coverImage}
                alt={`Portada de ${project.data.title} por ${project.data.artist}`}
                class={styles.coverImg}
                loading="lazy"
              />
              <div class={styles.hoverOverlay}>
                <span class={styles.overlayMeta}>
                  {project.data.category} &bull; {project.data.year}
                </span>
                <span class={styles.overlayAction}>VER PROYECTO &rarr;</span>
              </div>
            </div>
            <div class={styles.cardInfo}>
              <h3 class={styles.artist}>{project.data.artist}</h3>
              <span class={styles.title}>{project.data.title}</span>
              <div class={styles.badgeRow}>
                {project.data.serviceBadges.slice(0, 2).map((badge: { slug: string; label: string }) => (
                  <span class={styles.miniBadge}>[{badge.label}]</span>
                ))}
              </div>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
)}

<script is:inline>
  (function () {
    function setupCarousels() {
      if (window.__centellaCarouselCleanups) {
        window.__centellaCarouselCleanups.forEach(function (cleanup) {
          try { cleanup(); } catch (e) {}
        });
      }
      window.__centellaCarouselCleanups = [];

      var carousels = document.querySelectorAll('[data-projects-carousel]');
      if (!carousels.length) return;

      carousels.forEach(function (carousel) {
        var wrapper = carousel.querySelector('[data-carousel-wrapper]');
        var firstGroup = carousel.querySelector('[data-carousel-group]');
        var toggleBtn = carousel.querySelector('[data-carousel-toggle]');
        var reverseBtn = carousel.querySelector('[data-carousel-reverse]');

        if (!wrapper || !firstGroup) return;

        var isManualPaused = false;
        var isHovered = false;
        var isTouching = false;
        var isDragging = false;
        var isPointerDown = false;
        var isRealDrag = false;
        var direction = 1;
        var speed = 0.75;

        var dragResumeTimeout;
        var touchResumeTimeout;

        function getGroupWidth() {
          return firstGroup ? firstGroup.offsetWidth : 0;
        }

        function initScrollPos() {
          var W = getGroupWidth();
          if (W > 0) {
            if (wrapper.scrollLeft < W || wrapper.scrollLeft >= 2 * W) {
              wrapper.scrollLeft = W;
            }
          }
        }

        initScrollPos();
        var t1 = setTimeout(initScrollPos, 100);
        var t2 = setTimeout(initScrollPos, 400);

        function normalizeScroll() {
          var W = getGroupWidth();
          if (W <= 0) return;
          if (wrapper.scrollLeft >= 2 * W) {
            wrapper.scrollLeft -= W;
          } else if (wrapper.scrollLeft < W) {
            wrapper.scrollLeft += W;
          }
        }

        function onScroll() {
          normalizeScroll();
        }
        wrapper.addEventListener('scroll', onScroll, { passive: true });

        // Pointer Drag Tracking
        var startX = 0;
        var startY = 0;
        var lastX = 0;

        function onPointerDown(e) {
          if (e.button !== 0) return;
          isPointerDown = true;
          isRealDrag = false;
          startX = e.clientX;
          startY = e.clientY;
          lastX = e.clientX;
          if (dragResumeTimeout) clearTimeout(dragResumeTimeout);
        }

        function onPointerMove(e) {
          if (!isPointerDown) return;
          var dx = e.clientX - lastX;
          lastX = e.clientX;

          if (!isRealDrag) {
            var dist = Math.hypot(e.clientX - startX, e.clientY - startY);
            if (dist > 8) {
              isRealDrag = true;
              isDragging = true;
              wrapper.setAttribute('data-dragging', 'true');
            }
          }

          if (isRealDrag) {
            wrapper.scrollLeft -= dx;
            normalizeScroll();
          }
        }

        function stopDragging() {
          if (!isPointerDown) return;
          isPointerDown = false;
          wrapper.removeAttribute('data-dragging');
          if (isRealDrag) {
            dragResumeTimeout = setTimeout(function () {
              isDragging = false;
              isRealDrag = false;
            }, 1200);
          } else {
            isDragging = false;
          }
        }

        wrapper.addEventListener('pointerdown', onPointerDown);
        window.addEventListener('pointermove', onPointerMove);
        window.addEventListener('pointerup', stopDragging);
        window.addEventListener('pointercancel', stopDragging);

        // Intercept click ONLY if it was a real drag
        function onClick(e) {
          if (isRealDrag) {
            e.preventDefault();
            e.stopPropagation();
            isRealDrag = false;
          }
        }
        wrapper.addEventListener('click', onClick, true);

        // Mobile touch interaction
        function onTouchStart() {
          isTouching = true;
          if (touchResumeTimeout) clearTimeout(touchResumeTimeout);
        }
        function onTouchEnd() {
          touchResumeTimeout = setTimeout(function () {
            isTouching = false;
          }, 1800);
        }
        wrapper.addEventListener('touchstart', onTouchStart, { passive: true });
        wrapper.addEventListener('touchend', onTouchEnd, { passive: true });

        // Hover pauses auto-scroll on desktop
        function onPointerEnter(e) {
          if (e.pointerType === 'mouse') {
            isHovered = true;
          }
        }
        function onPointerLeave(e) {
          if (e.pointerType === 'mouse') {
            isHovered = false;
          }
        }
        wrapper.addEventListener('pointerenter', onPointerEnter);
        wrapper.addEventListener('pointerleave', onPointerLeave);

        // Control buttons
        function onToggleClick() {
          isManualPaused = !isManualPaused;
          if (toggleBtn) {
            // toggleBtn.textContent = isManualPaused ? '[▶]' : '[⏸]';
            toggleBtn.textContent = isManualPaused ? '[▶]' : '[⏹]';
          }
        }
        if (toggleBtn) {
          toggleBtn.addEventListener('click', onToggleClick);
        }

        function onReverseClick() {
          direction = -direction;
          if (reverseBtn) {
            reverseBtn.textContent = direction < 0 ? '[⇄]' : '[⇄]';
          }
        }
        if (reverseBtn) {
          reverseBtn.addEventListener('click', onReverseClick);
        }

        if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          isManualPaused = true;
          if (toggleBtn) toggleBtn.textContent = '[(U+25B6)]';
        }

        // Animation Loop
        var lastTime = performance.now();
        var animFrameId;

        function tick(now) {
          var dt = Math.min((now - lastTime) / 1000, 0.1);
          lastTime = now;

          var shouldAutoScroll = !isManualPaused && !isHovered && !isTouching && !isDragging;

          if (shouldAutoScroll) {
            var delta = speed * 60 * dt * direction;
            wrapper.scrollLeft += delta;
            normalizeScroll();
          }

          animFrameId = requestAnimationFrame(tick);
        }

        animFrameId = requestAnimationFrame(tick);

        // Register cleanup for page navigation
        window.__centellaCarouselCleanups.push(function () {
          cancelAnimationFrame(animFrameId);
          clearTimeout(t1);
          clearTimeout(t2);
          if (dragResumeTimeout) clearTimeout(dragResumeTimeout);
          if (touchResumeTimeout) clearTimeout(touchResumeTimeout);
          wrapper.removeEventListener('scroll', onScroll);
          wrapper.removeEventListener('pointerdown', onPointerDown);
          window.removeEventListener('pointermove', onPointerMove);
          window.removeEventListener('pointerup', stopDragging);
          window.removeEventListener('pointercancel', stopDragging);
          wrapper.removeEventListener('click', onClick, true);
          wrapper.removeEventListener('touchstart', onTouchStart);
          wrapper.removeEventListener('touchend', onTouchEnd);
          wrapper.removeEventListener('pointerenter', onPointerEnter);
          wrapper.removeEventListener('pointerleave', onPointerLeave);
          if (toggleBtn) toggleBtn.removeEventListener('click', onToggleClick);
          if (reverseBtn) reverseBtn.removeEventListener('click', onReverseClick);
        });
      });
    }

    // Bind setup on both page-load and DOM events
    document.addEventListener('astro:page-load', setupCarousels);
    if (document.readyState === 'interactive' || document.readyState === 'complete') {
      setupCarousels();
    } else {
      document.addEventListener('DOMContentLoaded', setupCarousels);
    }
  })();
</script>
