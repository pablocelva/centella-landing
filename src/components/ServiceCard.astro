---
import styles from './ServiceCard.module.css';

interface Props {
  id?: string;
  slug?: string;
  number: string;
  title: string;
  summary: string;
  tagline: string;
  details: string[];
  hasPlans?: boolean;
}

const { id, slug, number, title, summary, tagline, details, hasPlans = false } = Astro.props;
const targetSlug = slug || id;
---

<article class={styles.card} id={id}>
  <div class={styles.header}>
    <span class={styles.number}>[{number}]</span>
    <span class={styles.tagline}>{tagline}</span>
  </div>

  <h3 class={styles.title}>
    {targetSlug ? (
      <a href={`/servicios/${targetSlug}`} class={styles.titleLink}>
        {title}
      </a>
    ) : (
      title
    )}
  </h3>

  <p class={styles.summary}>{summary}</p>

  <ul class={styles.detailsList}>
    {details.map(item => {
      const colonIndex = item.indexOf(':');
      const concept = colonIndex !== -1 ? item.slice(0, colonIndex).trim() : item;

      return (
        <li class={styles.detailItem}>
          <span class={styles.bullet}></span>
          <span class={styles.detailText}>{concept}</span>
        </li>
      );
    })}
  </ul>

  {targetSlug && (
    <div class={styles.footer}>
      <a href={`/servicios/${targetSlug}`} class={styles.detailLink}>
        {hasPlans ? '[VER DETALLES Y PLANES →]' : '[VER INFORMACIÓN DETALLADA →]'}
      </a>
    </div>
  )}
</article>
