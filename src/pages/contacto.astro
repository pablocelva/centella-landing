---
import Layout from '../layouts/Layout.astro';
import styles from './contacto.module.css';

const contactEmail = "contacto@estudiocentella.cl";
---

<Layout
  title="Contacto & Reservas — Estudio Centella Chile"
  description="Ponte en contacto con Estudio Centella en Santiago de Chile para presupuestos de producción musical, mezcla, masterización y grabación."
>
  <div class={styles.container}>
    <!-- Hero Banner Ancho Completo -->
    <section class={styles.heroBanner} aria-labelledby="contact-heading">
      <span class={styles.tag}>[05] CONTACTO &amp; RESERVA DE SESIONES</span>
      <h1 id="contact-heading" class={styles.title}>
        Platiquemos sobre tu próximo proyecto discográfico o sesión de estudio.
      </h1>
    </section>

    <!-- Grid de Formulario y Redes / Email -->
    <div class={styles.contactGrid}>
      <!-- Formulario de Contacto -->
      <section class={styles.formCard} aria-labelledby="form-heading">
        <h2 id="form-heading" class={styles.sectionHeader}>[01] FORMULARIO DE REQUERIMIENTOS</h2>
        
        <form id="contactForm" action="#" method="POST">
          <div style="display: flex; flex-direction: column; gap: 20px;">
            <div class={styles.formGroup}>
              <label for="name" class={styles.label}>Nombre o Nombre de Banda / Artista *</label>
              <input type="text" id="name" name="name" required class={styles.input} placeholder="ej. Camila Vega / Dúo Ámbar" />
            </div>

            <div class={styles.formGroup}>
              <label for="email" class={styles.label}>Correo Electrónico *</label>
              <input type="email" id="email" name="email" required class={styles.input} placeholder="tu@correo.com" />
            </div>

            <div class={styles.formGroup}>
              <label for="service" class={styles.label}>Servicio Requerido *</label>
              <select id="service" name="service" required class={styles.select}>
                <option value="" disabled selected>Selecciona un servicio...</option>
                <option value="produccion">Producción Musical Integral</option>
                <option value="mezcla">Mezcla de Audio</option>
                <option value="masterizacion">Masterización Estéreo / Stem</option>
                <option value="edicion">Edición &amp; Limpieza Vocal</option>
                <option value="consultoria">Consultoría de Sonido</option>
                <option value="grabacion">Grabación en Estudio (Santiago)</option>
              </select>
            </div>

            <div class={styles.formGroup}>
              <label for="message" class={styles.label}>Detalles del Proyecto / Formato de Grabación *</label>
              <textarea id="message" name="message" required class={styles.textarea} placeholder="Cuéntanos sobre tu música, número de canciones, instrumentos y fecha estimada de entrega..."></textarea>
            </div>

            <button type="submit" class={styles.submitBtn}>
              ENVIAR MENSAJE DE CONSULTA &rarr;
            </button>
          </div>
        </form>
      </section>

      <!-- Sidebar: Redes Sociales & Botón Copiar Correo Gmail -->
      <aside class={styles.sidebarCard}>
        <h2 class={styles.sectionHeader}>[02] DIRECCIÓN DE CORREO &amp; REDES</h2>

        <!-- Botón para copiar Gmail / Email al clipboard -->
        <div>
          <button id="copyEmailBtn" class={styles.copyBtn} title="Haz clic para copiar el correo electrónico al portapapeles">
            <span class={styles.iconGroup}>
              <!-- SVG Icon Envelope / Gmail -->
              <svg class={styles.svgIcon} viewBox="0 0 24 24">
                <path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/>
              </svg>
              <span>{contactEmail}</span>
            </span>
            <span>COPIAR</span>
          </button>
          <div id="copyToast" class={styles.toast}>
            &check; ¡Correo {contactEmail} copiado al portapapeles!
          </div>
        </div>

        <!-- Lista de Redes Sociales con Iconos SVG -->
        <div class={styles.socialList}>
          <a href="https://instagram.com/estudiocentella" target="_blank" rel="noopener noreferrer" class={styles.socialItem}>
            <span class={styles.iconGroup}>
              <!-- Instagram SVG -->
              <svg class={styles.svgIcon} viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
              <span>INSTAGRAM</span>
            </span>
            <span>@estudiocentella</span>
          </a>

          <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class={styles.socialItem}>
            <span class={styles.iconGroup}>
              <!-- YouTube SVG -->
              <svg class={styles.svgIcon} viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
              <span>YOUTUBE</span>
            </span>
            <span>Estudio Centella</span>
          </a>

          <a href="https://spotify.com" target="_blank" rel="noopener noreferrer" class={styles.socialItem}>
            <span class={styles.iconGroup}>
              <!-- Spotify SVG -->
              <svg class={styles.svgIcon} viewBox="0 0 24 24">
                <path d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.517 17.322c-.22.36-.689.475-1.049.255-2.87-1.753-6.48-2.15-10.73-1.179-.407.094-.816-.16-.91-.567-.094-.407.16-.816.567-.91 4.653-1.062 8.647-.611 11.87 1.356.36.22.476.69.252 1.045zm1.472-3.275c-.277.449-.868.594-1.317.318-3.284-2.018-8.29-2.607-12.176-1.428-.507.154-1.04-.135-1.194-.642-.154-.507.135-1.04.642-1.194 4.437-1.348 9.948-.696 13.727 1.629.449.276.594.867.318 1.317zm.126-3.414C15.19 8.358 8.729 8.143 4.975 9.282c-.624.19-1.283-.165-1.473-.789-.19-.624.165-1.283.789-1.473 4.309-1.308 11.45-1.06 15.8 1.523.562.334.747 1.063.413 1.625-.333.562-1.063.748-1.624.412z"/>
              </svg>
              <span>SPOTIFY</span>
            </span>
            <span>Playlist Oficial</span>
          </a>
        </div>
      </aside>
    </div>
  </div>
</Layout>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const btn = document.getElementById('copyEmailBtn');
    const toast = document.getElementById('copyToast');
    const form = document.getElementById('contactForm');

    if (form) {
      form.addEventListener('submit', (evt) => {
        evt.preventDefault();
        alert('¡Gracias por comunicarte! Tu mensaje ha sido registrado.');
      });
    }

    if (btn && toast) {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText('contacto@estudiocentella.cl').then(() => {
          toast.classList.add('_show_42n51_1');
          setTimeout(() => {
            toast.classList.remove('_show_42n51_1');
          }, 3000);
        }).catch(err => {
          console.error('Error al copiar correo:', err);
        });
      });
    }
  });
</script>
