---
import Layout from '../layouts/Layout.astro';
import ProjectsCarousel from '../components/ProjectsCarousel.astro';
import { getCollection } from 'astro:content';
import styles from './index.module.css';

const allProjects = await getCollection('proyectos');
const sortedProjects = allProjects.sort((a, b) => a.data.order - b.data.order);

const allServices = await getCollection('servicios');
const activeServices = allServices
  .filter(s => s.data.active !== false)
  .sort((a, b) => a.data.order - b.data.order);

const homeServiceBgMap: Record<string, string> = {
  'produccion-musical':
    'https://images.unsplash.com/photo-1701100629891-2f1aae1efed6?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D',
  mezcla:
    'https://images.unsplash.com/photo-1509310202330-aec5af561c6b?q=80&w=1209&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D',
  'consultoria-sonido':
    'https://images.unsplash.com/photo-1621619054919-167f2fcf135c?q=80&w=1166&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=NHwxMjA3fDA%3D',
};

function getHomeServiceBg(id: string): string | undefined {
  if (homeServiceBgMap[id]) return homeServiceBgMap[id];
  if (id.includes('produccion')) return homeServiceBgMap['produccion-musical'];
  if (id.includes('mezcla')) return homeServiceBgMap.mezcla;
  if (id.includes('consultoria')) return homeServiceBgMap['consultoria-sonido'];
  return undefined;
}
---

<Layout
  title="Estudio Centella — Producción Musical & Mezcla en Chile"
  description="Estudio de producción musical, mezcla y edición de audio en Santiago, Chile."
>
  <div class={styles.container}>
    <!-- Bloque 1: Banner Superior Ancho Completo -->
    <section class={styles.heroBanner} aria-labelledby="hero-heading">
      <div>
        <span class={styles.heroTag}>[01] ESTUDIO DE PRODUCCIÓN MUSICAL &amp; MEZCLA</span>
        <h1 id="hero-heading" class={styles.heroTitle}>
          Sonido orgánico, calidez y precisión técnica para tus producciones discográficas.
        </h1>
      </div>
      <div class={styles.heroMeta}>
        <span>ESTUDIO CENTELLA</span>
        <span>&mdash;</span>
        <span>SANTIAGO, CHILE / DISPONIBILIDAD GLOBAL</span>
      </div>
    </section>

    <!-- Bloque 2: Catálogo Discográfico & Carrusel Unificado -->
    <ProjectsCarousel
      sectionNumber="02"
      tag={`[02] CATÁLOGO DISCOGRÁFICO // ${sortedProjects.length} PRODUCCIONES`}
      title="Trabajos Destacados del Estudio"
    />

    <!-- Bloque 3: Servicios (Versión reducida como botones directos) -->
    <section class={styles.servicesSection} aria-labelledby="services-heading">
      <div class={styles.sectionHeaderBar}>
        <span class={styles.sectionTag}>[03] SERVICIOS DE PRODUCCIÓN &amp; INGENIERÍA</span>
        <a href="/servicios" class={styles.sectionLink}>
          EXPLORAR DETALLES Y TARIFAS &rarr;
        </a>
      </div>

      <div class={styles.serviceButtonsGrid}>
        {activeServices.map(servicio => {
          const bgImage = getHomeServiceBg(servicio.id);
          return (
            <a
              href={`/servicios/${servicio.id}`}
              class={styles.serviceBtn}
            >
              {bgImage && (
                <>
                  <img
                    src={bgImage}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class={styles.serviceBtnBg}
                  />
                  <span class={styles.serviceBtnOverlay} aria-hidden="true"></span>
                </>
              )}
              <span class={styles.serviceBtnNumber}>[{servicio.data.number}]</span>
              <span class={styles.serviceBtnTitle}>{servicio.data.title}</span>
              <span class={styles.serviceBtnArrow} aria-hidden="true">&rarr;</span>
            </a>
          );
        })}
      </div>
    </section>

    <!-- Bloque 4: Banner CTA Final -->
    <div class={styles.ctaBanner}>
      <span class={styles.ctaBannerText}>
        ¿TIENES UN PROYECTO O ÁLBUM EN PUERTA? Escríbeme para agendar una sesión de evaluación de tu material.
      </span>
      <a href="/contacto" class={styles.ctaBannerBtn}>
        AGENDAR SESIÓN &rarr;
      </a>
    </div>
  </div>
</Layout>
