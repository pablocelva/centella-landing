---
import Layout from '../../layouts/Layout.astro';
import ProjectGridCard from '../../components/ProjectGridCard.astro';
import ProjectFilter from '../../components/ProjectFilter.astro';
import { getCollection } from 'astro:content';
import styles from './proyectos.module.css';

const allProjects = await getCollection('proyectos');
const sortedProjects = allProjects.sort((a, b) => {
  const yearA = parseInt(a.data.year, 10) || 0;
  const yearB = parseInt(b.data.year, 10) || 0;
  if (yearB !== yearA) {
    return yearB - yearA; // Most recent year first
  }
  return a.data.order - b.data.order;
});

const years = sortedProjects.map(p => parseInt(p.data.year, 10)).filter(y => !isNaN(y));
const minYear = years.length > 0 ? Math.min(...years) : 2020;
const maxYear = years.length > 0 ? Math.max(...years) : new Date().getFullYear();
const yearRange = minYear === maxYear ? `${minYear}` : `${minYear} \u2013 ${maxYear}`;
---

<Layout
  title="Catálogo de Producciones Musicales — Estudio Centella"
  description="Explora las producciones musicales, mezclas y grabaciones realizadas en Estudio Centella."
>
  <div class={styles.container}>
    <section class={styles.heroBanner} aria-labelledby="archive-heading">
      <div>
        <span class={styles.heroTag}>[02] CATÁLOGO COMPLETO DE PRODUCCIONES</span>
        <h1 id="archive-heading" class={styles.heroTitle}>
          Álbumes, EPs y sencillos producidos, mezclados y grabados en el estudio.
        </h1>
      </div>
      <div class={styles.heroMeta}>
        <span>DISCOGRAFÍA [{sortedProjects.length}]</span>
        <span>&mdash;</span>
        <span>{yearRange}</span>
      </div>
    </section>

    <section aria-labelledby="grid-heading" class={styles.catalogSection}>
      <h2 id="grid-heading" class="sr-only" style="position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0;">
        Lista de canciones y producciones
      </h2>

      <ProjectFilter />

      <div class={styles.projectsGrid}>
        {sortedProjects.map((proyecto, index) => (
          <ProjectGridCard
            id={proyecto.id}
            title={proyecto.data.title}
            artist={proyecto.data.artist}
            year={proyecto.data.year}
            category={proyecto.data.category}
            coverImage={proyecto.data.coverImage}
            serviceBadges={proyecto.data.serviceBadges}
            index={index}
          />
        ))}
      </div>
    </section>
  </div>
</Layout>

