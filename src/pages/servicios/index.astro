---
import Layout from '../../layouts/Layout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { getCollection } from 'astro:content';
import styles from './servicios.module.css';

const allServices = await getCollection('servicios');
const activeServices = allServices
  .filter(servicio => servicio.data.active !== false)
  .sort((a, b) => a.data.order - b.data.order);

const servicePairs = [];
for (let i = 0; i < activeServices.length; i += 2) {
  servicePairs.push(activeServices.slice(i, i + 2));
}
---

<Layout
  title="Servicios de Producción Musical — Estudio Centella"
  description="Servicios profesionales de producción musical, mezcla, edición vocal y consultoría acústica."
>
  <div class={styles.container}>
    <!-- Hero Banner Ancho Completo -->
    <section class={styles.heroBanner} aria-labelledby="services-heading">
      <span class={styles.tag}>[03] SERVICIOS DE PRODUCCIÓN &amp; INGENIERÍA DE SONIDO</span>
      <h1 id="services-heading" class={styles.title}>
        Servicios integrales de producción y procesamiento de audio para producciones discográficas.
      </h1>
    </section>

    {servicePairs.map((pair, index) => (
      <>
        <!-- Grupo de Servicios -->
        <section class={styles.pairGrid} aria-label={`Grupo de servicios ${index + 1}`}>
          {pair.map(servicio => (
            <ServiceCard
              id={servicio.id}
              number={servicio.data.number}
              title={servicio.data.title}
              summary={servicio.data.summary}
              tagline={servicio.data.tagline}
              details={servicio.data.details}
            />
          ))}
        </section>

        {index === 0 && (
          <div class={styles.fullBanner}>
            <span class={styles.fullBannerText}>
              FLUJO DE TRABAJO EN ESTUDIO &mdash; Pre-producción técnica, sesiones de captura, balance de mezcla y entrega de archivos finales para plataformas digitales.
            </span>
            <span class={styles.fullBannerMeta}>[01] TRABAJO PROFESIONAL</span>
          </div>
        )}

        {index === 1 && (
          <div class={styles.fullBanner}>
            <span class={styles.fullBannerText}>
              CALIDAD DE AUDIO &mdash; Archivos de alta resolución en 24-bit/96kHz con balance dinámico y claridad acústica.
            </span>
            <span class={styles.fullBannerMeta}>[02] CERO DISTORSIÓN</span>
          </div>
        )}
      </>
    ))}

    <!-- Banner Ancho Completo CTA -->
    <div class={styles.fullBanner}>
      <span class={styles.fullBannerText}>
        ¿TIENES UN PROYECTO O ÁLBUM EN PUERTA? Agenda una sesión de evaluación de tu material con nuestro equipo.
      </span>
      <a href="/contacto" class={styles.ctaLink}>
        AGENDAR SESIÓN &rarr;
      </a>
    </div>
  </div>
</Layout>
